{
    "name": "@goauthentik/authentik",
    "version": "2026.5.0-rc1",
    "private": true,
    "scripts": {
        "lint": "run-s lint:spellcheck lint:lockfile",
        "lint:lockfile": "./scripts/node/lint-lockfile.mjs",
        "lint:node": "./scripts/node/lint-runtime.mjs",
        "lint:spellcheck": "echo 'Skipping spellcheck linting'",
        "pack": "corepack pack",
        "update-corepack": "./scripts/node/update-corepack.mjs"
    },
    "type": "module",
    "dependencies": {
        "@eslint/js": "^9.39.1",
        "@goauthentik/eslint-config": "./packages/eslint-config",
        "@goauthentik/prettier-config": "./packages/prettier-config",
        "@goauthentik/tsconfig": "./packages/tsconfig",
        "@typescript-eslint/eslint-plugin": "^8.48.1",
        "@typescript-eslint/parser": "^8.48.1",
        "eslint": "^9.39.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.8.1",
        "prettier-plugin-packagejson": "^3.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1"
    },
    "workspaces": [],
    "engines": {
        "node": ">=24",
        "npm": ">=11.10.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "onFail": "warn",
            "version": ">=24"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.10.0",
            "onFail": "warn"
        }
    },
    "packageManager": "npm@11.10.0+sha512.8bc844e37892200305b98562f13c6c10849d10b3387c8cdaeb4d1a2e32746a79063cba9dd284cf28c26a01c3bf4169b7d3b31b4a5586cc970d6749463108073c",
    "prettier": "@goauthentik/prettier-config",
    "overrides": {
        "format-imports": {
            "eslint": "$eslint"
        }
    }
}
